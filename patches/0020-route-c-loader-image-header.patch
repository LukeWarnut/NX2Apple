From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LNPANDY <lnp-andy@hotmail.com>
Date: Thu, 29 Oct 2026 00:08:14 +0800
Subject: [PATCH] DM_FRAMEWORK: a settable image header for the loader

The iOS loader reads the game's embedded module sections from a fixed
&_mh_execute_header. dm_set_game_image_header() (loader_image.h) replaces it with
the image a framework build names, and unset it is still the executable, so the
default build's path is unchanged. map_image() and nro_pieces() use it; the host's
own tables (__DATA,swforce in force_init, __DATA,swhle in hle.c) stay the
executable's.

Route C M1, docs/launcher-c-plan.md.

Upstream-Status: pending
Reason: route C M1: game modules as an opt-in framework
Issue: LNPANDY/NX2Apple#144

---
 dm/host/loader.c       | 10 +++++++++-
 dm/host/loader_image.h | 19 +++++++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)
 create mode 100644 dm/host/loader_image.h

diff --git a/dm/host/loader.c b/dm/host/loader.c
index c45124eb..d3ec4c0c 100644
--- a/dm/host/loader.c
+++ b/dm/host/loader.c
@@ -10,9 +10,15 @@
 #include <mach-o/getsect.h>
 #include <mach-o/ldsyms.h>
 #include "hle.h"
+#include "loader_image.h"
 
 module_t *g_mod;
 int g_nmod;
+// The image whose sections carry the game's modules (loader_image.h): the executable itself unless a framework build
+// (build_ipa.sh DM_FRAMEWORK=1) hands in DmGame.framework's header after dlopen, before loading starts. Only the module
+// sections are read from it; the host's own tables (__DATA,swforce in force_init, __DATA,swhle in hle.c) stay in the executable.
+static const void *g_module_image_mh;
+void dm_set_game_image_header(const void *mh) { g_module_image_mh = mh; }
 // Stable module addresses live in g_mod; lookup order follows activation, including unload/reload.
 static module_t **g_loaded; static int g_nloaded, g_mod_capacity;
 static pthread_rwlock_t g_modules_mu = PTHREAD_RWLOCK_INITIALIZER;
@@ -511,7 +517,9 @@ static void remap_at(module_t *m, vm_address_t to, const void *from, unsigned lo
     if (kr != KERN_SUCCESS || a != to) die("%s vm_remap %p → %#lx (%#lx bytes) failed: %d", m->name, from, (unsigned long)to, size, kr);
     if ((cur & need) != need) die("%s permissions after vm_remap %#x, missing %#x", m->name, cur, need);
 }
-#define IMAGE_MH (&_mh_execute_header)
+// The image the module sections are read from: the executable's own embedded segments in the default build, or the
+// framework's when dm_set_game_image_header() named one (route C). getsectiondata() works on any loaded image's header
+#define IMAGE_MH ((const struct mach_header_64 *)(g_module_image_mh ? g_module_image_mh : (const void *)&_mh_execute_header))
 // The NRO modules (loader.c "NRO modules") are packed instead of getting sections of their own: a Mach-O file has at most 255 sections, and Super Smash Bros. Ultimate's 98 NROs would
 // take 294. gen_embed.py puts their pieces one after another, each 16K aligned, in __TEXT,__dm_nro_x0 / __DM_NRO_W,__img / __TEXT,__dm_nro_x1, and __DATA,__dm_nro_tab lists them:
 // 32 bytes of name, then the offset and length of its x0, W and x1 pieces in their sections (u64 each). A module name never holds an underscore, so these names meet no module's
diff --git a/dm/host/loader_image.h b/dm/host/loader_image.h
new file mode 100644
index 00000000..80948960
--- /dev/null
+++ b/dm/host/loader_image.h
@@ -0,0 +1,19 @@
+// The mach header the iOS loader reads the game's embedded module sections from (loader.c: map_image, nro_pieces).
+// The default build compiles those sections into the executable itself and reads &_mh_execute_header. A route C
+// build (DM_FRAMEWORK=1, docs/launcher-c-plan.md) compiles them into DmIOS.app/Frameworks/DmGame.framework instead:
+// iOS may not map new executable code from disk, so the framework is dlopen()ed from the signed bundle and its
+// header, taken from dladdr of a marker the framework exports, is handed here before dm_host_preload_start() runs.
+// Horizon's own rtld has no such indirection; it exists only because the image that carries the code is chosen at
+// build time (the executable) or at launch (the framework).
+// Set once, before loading starts: the loader reads it on the preload thread and every later module (NRO) load.
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void dm_set_game_image_header(const void *mh);
+
+#ifdef __cplusplus
+}
+#endif
